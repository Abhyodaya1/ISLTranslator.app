# Model files (large binary files)
# Uncomment if you don't want to track model files
# *.h5
# *.pb
# *.pth
# *.ckpt
# *.caffemodel

# ML artifacts (ignore by default)
Model/*.h5
Model/*.keras
Model/*.hdf5
Model/*.pb
Model/*.tflite
Model/*.onnx
Model/*.ckpt
Model/*.weights
Model/*.pt
Model/*.pth
Model/*.pkl
Model/*.joblib
Model/*.npz
Model/*.npy

# Binaries & archives
*.exe
*.dll
*.so
*.zip
*.tar
*.gz
*.7z

# Dataset raw archives (keep structure)
Data/raw/**
!Data/raw/.gitkeep

# Explicitly whitelist and track outputs/ folder
!outputs/**
!outputs/*
!outputs/**/*

# General image ignore (except Data and outputs)
*.png
*.jpg
*.jpeg
!outputs/**
!outputs/*
!outputs/**/*
!Data/**/*.jpg
!Data/**/*.jpeg
!Data/**/*.png

